<!DOCTYPE RCC>
<RCC>
  <qresource prefix="/">
    <file>qml/login.qml</file>
    <file>qml/components/FlatTextField.qml</file>
    <file>qml/components/InputUser.qml</file>
    <file>qml/components/InputPassword.qml</file>
    <file>qml/components/InputBase.qml</file>
  </qresource>
  <qresource prefix="/font">
    <file alias="iconfont.ttf">iconfont/iconfont.ttf</file>
  </qresource>
  <qresource prefix="/icons">
    <file alias="icon.ico">icons/icon.ico</file>
  </qresource>
  <qresource prefix="/theme">
    <file alias="checkbox.qss">theme/checkbox.qss</file>
    <file alias="buttons.qss">theme/buttons.qss</file>
    <file alias="menubar.qss">theme/menubar.qss</file>
    <file alias="advanceddock.qss">theme/advanceddock.qss</file>
  </qresource>
  <qresource prefix="/avatar">
    <file alias="avatar.png">avatar/avatar.png</file>
  </qresource>
</RCC>

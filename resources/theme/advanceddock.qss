 ads--CDockManager,
 ads--CDockContainerWidget,
 ads--CDockAreaWidget,
 ads--CDockWidget {
     background: transparent;
     background-color: transparent;
     border: none;
 }

 ads--CFloatingDockContainer {
     background: rgba(106, 122, 239, 1);
     border: none;
 }

 ads--CDockAreaTabBar {
     background: transparent;
     background-color: transparent;
     padding: 0px;
     margin: 0px;
 }

 ads--CDockWidgetTab {
     background: rgba(255, 255, 255, 30);
     color: snow;
     border-radius: 0px;
     margin: 0px;
     padding: 0px 4px 0px 4px;
 }

 ads--CDockWidgetTab QLabel {
     margin-left: 0px;
     padding: 0px;
 }

 ads--CDockWidgetTab[activeTab=true] {
     background: rgba(255, 255, 255, 80);
     font-weight: bold;
 }

 ads--CDockAreaTitleBar {
     background: rgba(0, 0, 0, 30);
     border-bottom: 1px solid rgba(255, 255, 255, 10);
 }

 ads--CDockAreaTitleBar QLabel {
     color: snow;
     margin-left: 0px;
     padding: 0px;
 }

 QSplitter::handle {
     background: rgba(255, 255, 255, 15);
 }

 /* 恢复并美化按钮 */
 ads--CDockAreaTitleBar QPushButton,
 ads--CDockAreaTitleBar QToolButton,
 ads--CDockWidgetTab QPushButton,
 ads--CDockWidgetTab QToolButton,
 #dockAreaAutoHideButton,
 #dockAreaCloseButton,
 #detachGroupButton,
 #tabsMenuButton {
     background: transparent !important;
     background-color: transparent !important;
     border: none;
     width: 16px;
     height: 16px;
     padding: 0px;
     margin-left: 0px;
 }

 ads--CDockAreaTitleBar QPushButton:hover,
 ads--CDockAreaTitleBar QToolButton:hover,
 ads--CDockWidgetTab QPushButton:hover,
 ads--CDockWidgetTab QToolButton:hover,
 #dockAreaAutoHideButton:hover,
 #dockAreaCloseButton:hover,
 #detachGroupButton:hover,
 #tabsMenuButton:hover,
 #dockAreaAutoHideButton:checked {
     background: rgba(255, 255, 255, 30) !important;
     border-radius: 0px;
 }

 /* 隐藏 TabsMenuButton 右下角的小三角 (menu-indicator) */
 ads--CDockAreaTitleBar QPushButton#tabsMenuButton::menu-indicator,
 ads--CDockAreaTitleBar #tabsMenuButton::menu-indicator,
 #tabsMenuButton::menu-indicator {
     width: 0px;
     height: 0px;
 }

 /* 针对停靠窗内部的滚动区域等可能存在的白底部件进行穿透 */
 QScrollArea,
 QScrollArea>QWidget>QWidget {
     background: transparent;
     background-color: transparent;
     border: none;
 }